# AI Cybersecurity Assistant - Environment Configuration

# Application Metadata
PROJECT_NAME="AI Cybersecurity Assistant"
VERSION="0.2.0"

# Knowledge Base Paths
MASTER_KB_PATH="data/master/ai_security_vulnerability_kb_master_v0.2.json"
BASELINE_KB_SHA256="d59af97e75dce8540f5dfaf1ba2d4e4afbcfe99c2ac697779bb5e9c6c0e99471"

# Vector Store (Phase 3+)
QDRANT_STORAGE_PATH="./data/qdrant_db"
QDRANT_COLLECTION_NAME="cybersecurity_kb_chunks"

# Embedding Provider (Phase 3+)
# Options: "local" (Sentence-Transformers) | "gemini" | "openai"
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL_NAME="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# LLM Provider (Phase 4)
# Options: "mock" (default, offline testing) | "groq"
LLM_PROVIDER="mock"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=2048
GROQ_TIMEOUT_SECONDS=20.0
GROQ_MAX_RETRIES=2

# Experimental Retrieval Threshold (Disabled by default)
# Leave empty or omit to keep disabled
RETRIEVAL_SCORE_THRESHOLD=""

# CORS Allowed Origins
# Add your scanner frontend origin here if integrating from a separate origin (e.g. port 5173 or custom dev server).
# Accepts comma-separated string or JSON array.
# Defaults: http://localhost:3000, http://localhost:8000, http://127.0.0.1:3000, http://127.0.0.1:8000
CORS_ALLOW_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000"

# Public Demo Protections & Rate Limiting (Phase 4.4 / Deployment)
# Enforces in-memory sliding-window IP rate limit and max request payload size on chat endpoints.
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_REQUESTS_PER_MINUTE=15
MAX_REQUEST_BODY_BYTES=100000
